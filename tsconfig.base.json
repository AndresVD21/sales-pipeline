{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sales-pipeline/data": ["libs/data/src/index.ts"],
      "@sales-pipeline/data-access": ["libs/data-access/src/index.ts"],
      "@sales-pipeline/sales-pipeline/feature-convert": [
        "libs/sales-pipeline/feature-convert/src/index.ts"
      ],
      "@sales-pipeline/sales-pipeline/feature-home": [
        "libs/sales-pipeline/feature-home/src/index.ts"
      ],
      "@sales-pipeline/shared": ["libs/shared/src/index.ts"],
      "@sales-pipeline/styles": ["libs/styles/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
